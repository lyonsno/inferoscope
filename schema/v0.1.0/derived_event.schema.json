{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferoscope.local/schema/v0.1.0/derived_event.schema.json",
  "title": "inferoscope derived event v0.1.0 provisional",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "schema_version",
    "run_id",
    "token_index",
    "derivation_version",
    "derivation_config_id",
    "derived_payload"
  ],
  "properties": {
    "event_type": {
      "const": "token_derived"
    },
    "schema_version": {
      "const": "derived/v0.1.0-provisional"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "token_index": {
      "type": "integer",
      "minimum": 0
    },
    "derivation_version": {
      "type": "string",
      "minLength": 1
    },
    "derivation_config_id": {
      "type": "string",
      "minLength": 1
    },
    "derived_payload": {
      "type": "object",
      "description": "Provisional motif payload. Its nested fields are intentionally not fixed in v0.1.0."
    }
  }
}
