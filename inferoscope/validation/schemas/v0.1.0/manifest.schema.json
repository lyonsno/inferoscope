{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferoscope.local/schema/v0.1.0/manifest.schema.json",
  "title": "inferoscope manifest v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "model_id",
    "tokenizer_id",
    "prompt",
    "artifact_versions",
    "derivation_version",
    "derivation_config_id"
  ],
  "properties": {
    "schema_version": {
      "const": "manifest/v0.1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "tokenizer_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "generation_config": {
      "type": "object"
    },
    "capture_config": {
      "type": "object"
    },
    "derivation_version": {
      "type": "string",
      "minLength": 1
    },
    "derivation_config_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_event_schema_version",
        "derived_event_schema_version",
        "layout_schema_version",
        "motif_ledger_schema_version",
        "contingency_schema_version"
      ],
      "properties": {
        "raw_event_schema_version": {
          "const": "raw/v0.1.0"
        },
        "derived_event_schema_version": {
          "const": "derived/v0.1.0-provisional"
        },
        "layout_schema_version": {
          "const": "layout/v0.1.0"
        },
        "motif_ledger_schema_version": {
          "const": "motif_ledger/v0.1.0-provisional"
        },
        "contingency_schema_version": {
          "const": "contingency/v0.1.0-provisional"
        }
      }
    }
  }
}
